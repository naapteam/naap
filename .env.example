# Postgres 16 — Neon or a Mumbai VPS. Data stays in India.
DATABASE_URL=postgres://naap:naap@localhost:5432/naap

# Session cookie signing secret (32+ random bytes, base64 or hex)
SESSION_SECRET=change-me-to-a-long-random-string

# OTP delivery — leave unset in dev to log OTPs to the server console instead of sending SMS
SMS_API_KEY=
